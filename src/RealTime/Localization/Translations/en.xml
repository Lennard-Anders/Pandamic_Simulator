  <translation id="StaticBaselineEnabled" value="Enable static baseline" />
  <translation id="StaticBaselineEnabledTooltip" value="Locks the city demand bars to fixed target values while enabled. Optional controls below stay separate." />
  <translation id="StaticBaselineMode" value="Baseline mode" />
  <translation id="StaticBaselineModeTooltip" value="Switching to Growth resets all four demand targets to 100%, but you can still edit them afterwards. Stabilization keeps your configured targets without hidden freeze side effects." />
