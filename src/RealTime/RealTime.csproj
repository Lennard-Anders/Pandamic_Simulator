<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyTitle>RealTime</AssemblyTitle>
    <Company>dymanoid</Company>
    <Product>RealTime</Product>
    <Description>A mod for the Cities:Skylines game</Description>
    <Copyright>Copyright © 2018-2020, dymanoid</Copyright>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblySearchPaths>
      $(AssemblySearchPaths);
      $(CitiesSkylinesBinaries)
    </AssemblySearchPaths>
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <LangVersion>7.2</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Benchmark'">
    <DefineConstants>BENCHMARK</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <RealTimeDeployDir Condition="'$(RealTimeDeployDir)' == ''">$(CITIES_SKYLINES_MOD_DIR)</RealTimeDeployDir>
    <RealTimeDeployDir Condition="'$(RealTimeDeployDir)' != '' and !HasTrailingSlash('$(RealTimeDeployDir)')">$(RealTimeDeployDir)\</RealTimeDeployDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkyTools.Patching" Version="2.1.0" />
    <PackageReference Include="GitVersionTask" Version="5.2.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.FxCopAnalyzers" Version="2.9.8" />
    <PackageReference Include="Roslynator.Analyzers" Version="2.3.0" />
    <PackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="1.0.0-beta" />
    <PackageReference Include="StyleCop.Analyzers.Unstable" Version="1.2.0.164" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(CitiesSkylinesBinaries)Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="ColossalManaged">
      <HintPath>$(CitiesSkylinesBinaries)ColossalManaged.dll</HintPath>
    </Reference>
    <Reference Include="ICities">
      <HintPath>$(CitiesSkylinesBinaries)ICities.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(CitiesSkylinesBinaries)UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(CitiesSkylinesBinaries)UnityEngine.UI.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>RealTimeTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="GenerateTenusBuildIdentity" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <TenusGitCommit>unavailable</TenusGitCommit>
      <TenusGitBranch>unavailable</TenusGitBranch>
      <TenusRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</TenusRepositoryRoot>
      <TenusBuildIdentitySource>$(IntermediateOutputPath)TenusBuildIdentity.g.cs</TenusBuildIdentitySource>
    </PropertyGroup>
    <Exec Command="git -C &quot;$(TenusRepositoryRoot)&quot; rev-parse HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" Condition="Exists('$(TenusRepositoryRoot)\.git')">
      <Output TaskParameter="ConsoleOutput" PropertyName="TenusGitCommit" />
    </Exec>
    <Exec Command="git -C &quot;$(TenusRepositoryRoot)&quot; branch --show-current" ConsoleToMSBuild="true" IgnoreExitCode="true" Condition="Exists('$(TenusRepositoryRoot)\.git')">
      <Output TaskParameter="ConsoleOutput" PropertyName="TenusGitBranch" />
    </Exec>
    <WriteLinesToFile File="$(TenusBuildIdentitySource)" Lines="[assembly: RealTime.Experiments.TenusBuildIdentityAttribute(&quot;$(TenusGitCommit)&quot;, &quot;$(TenusGitBranch)&quot;)]" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(TenusBuildIdentitySource)" />
    </ItemGroup>
  </Target>
  <Target Name="DeployToModsDirectory" AfterTargets="Build" DependsOnTargets="Build" Condition="'$(RealTimeDeployDir)' != ''">
    <ItemGroup>
      <TranslationFiles Include="$(ProjectDir)Localization\Translations\*.xml" />
      <EventTemplates Include="$(ProjectDir)Events\Templates\*.xml" />
      <TargetBinaries Include="$(TargetDir)*.dll" Exclude="$(TargetDir)RealTimeTests.dll" />
    </ItemGroup>
    <Message Text="Deploying the mod package to: $(RealTimeDeployDir)" Importance="high" />
    <Delete Files="$(RealTimeDeployDir)RealTimeTests.dll" Condition="Exists('$(RealTimeDeployDir)RealTimeTests.dll')" />
    <Copy SourceFiles="@(TranslationFiles)" DestinationFolder="$(RealTimeDeployDir)Localization" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(EventTemplates)" DestinationFolder="$(RealTimeDeployDir)Events" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TargetBinaries)" DestinationFolder="$(RealTimeDeployDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
